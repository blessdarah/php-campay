{
    "name": "blessdarah/php-campay",
    "description": "PHP package wrapper for campay momo integration",
    "type": "library",
    "license": "MIT",
    "keywords": ["campay", "momo", "mobile money", "payments", "cameroon"],
    "authors": [
        {
            "name": "Bless Darah",
            "email": "blessdarahuba@gmail.com",
            "role": "developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^8.2"
    },
    "require-dev": {
        "pestphp/pest": "^5.3",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "BlessDarah\\PhpCampay\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "audit": "composer audit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
